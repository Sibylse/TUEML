X_plot = np.linspace(-3, 3, 500).reshape(-1, 1)
y_true = f(X_plot[:, 0])

# models: same width, increasing depth
models = {
    "linear model": None,
    "1 hidden ReLU layer": (1,),
    "2 hidden ReLU layers": (1, 1),
    "4 hidden ReLU layers": (1, 1, 1, 1),
}

fig, axes = plt.subplots(1, 4, figsize=(18, 4), sharey=True)

for ax, (title, hidden_layers) in zip(axes, models.items()):

    if hidden_layers is None:
        # MLP with no hidden layer is just a linear model
        from sklearn.linear_model import LinearRegression
        model = make_pipeline(StandardScaler(), LinearRegression())
    else:
        model = make_pipeline(
            StandardScaler(),
            MLPRegressor(
                hidden_layer_sizes=hidden_layers,
                activation="tanh",
                max_iter=5000,
                alpha=1e-6,
                random_state=42,
