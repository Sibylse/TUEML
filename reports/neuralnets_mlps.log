import numpy as np
import matplotlib.pyplot as plt

from sklearn.neural_network import MLPRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline

# target function
def f(x):
    return (
        np.sin(3 * x)
        + 0.5 * np.sin(7 * x)
        + 0.3 * x
        + 0.15 * x**2
    )

# data
